#!/bin/sh
set -eu

die() { printf 'herdr-dog: %s\n' "$*" >&2; exit 1; }
root=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
version=$(awk '$1 == "version" { gsub(/"/, "", $3); print $3; exit }' "$root/herdr-plugin.toml")
printf '%s\n' "$version" | awk '/^[0-9]+\.[0-9]+\.[0-9]+$/ { ok=1 } END { exit !ok }' || die "manifest version must be MAJOR.MINOR.PATCH"
tag=${1:-v$version}
[ "$tag" = "v$version" ] || die "release tag $tag does not match manifest version v$version"
command -v go >/dev/null 2>&1 || die "Go 1.22+ is required to build release binaries"

cd "$root"
mkdir -p dist
for os in darwin linux; do
    for arch in amd64 arm64; do
        asset="herdr-dog_${os}_${arch}"
        CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -trimpath -ldflags='-s -w' \
            -o "dist/$asset" ./cmd/herdr-dog
        printf 'herdr-dog: built %s for %s\n' "$asset" "$tag"
    done
done

cd dist
set -- herdr-dog_darwin_amd64 herdr-dog_darwin_arm64 herdr-dog_linux_amd64 herdr-dog_linux_arm64
if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$@" > SHA256SUMS
elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$@" > SHA256SUMS
else
    die "sha256sum or shasum is required to generate release checksums"
fi
